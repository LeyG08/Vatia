{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conductor.schema.json",
  "title": "Vatia · Atributos de familia conductor",
  "description": "Brief §4.3. color_normalizado se deriva automáticamente de rol (IRAM 2183 / AEA 90364): las cláusulas if/then rechazan combinaciones inválidas. El Checklist AEA (§6) advierte los obligatorios vacíos sin bloquear el guardado.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rol": {
      "enum": ["fase", "neutro", "tierra"],
      "description": "Enum estricto: no se acepta texto libre.",
      "x-obligatorio": true
    },
    "color_normalizado": {
      "enum": ["marron", "negro", "rojo", "celeste", "verde-amarillo"],
      "description": "Derivado automáticamente del rol. El usuario no puede elegir un color inválido para ese rol.",
      "x-obligatorio": false
    },
    "tipo_cable": {
      "enum": ["unipolar", "multipolar", "vaina"],
      "x-obligatorio": true
    },
    "material": {
      "enum": ["Cu", "Al"],
      "x-obligatorio": true
    },
    "seccion_mm2": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-obligatorio": true
    },
    "aislacion": {
      "enum": ["PVC", "XLPE", "EPR"],
      "x-obligatorio": true
    },
    "tension_asignada": {
      "type": "string",
      "description": "Ej: 0,6/1kV.",
      "x-obligatorio": true
    },
    "norma_iram": {
      "type": "string",
      "description": "Ej: IRAM NM 247-3.",
      "x-obligatorio": true
    }
  },
  "required": ["rol"],
  "allOf": [
    {
      "if": {
        "properties": { "rol": { "const": "fase" }, "color_normalizado": { "type": "string" } },
        "required": ["rol", "color_normalizado"]
      },
      "then": {
        "properties": { "color_normalizado": { "enum": ["marron", "negro", "rojo"] } }
      }
    },
    {
      "if": {
        "properties": { "rol": { "const": "neutro" }, "color_normalizado": { "type": "string" } },
        "required": ["rol", "color_normalizado"]
      },
      "then": {
        "properties": { "color_normalizado": { "const": "celeste" } }
      }
    },
    {
      "if": {
        "properties": { "rol": { "const": "tierra" }, "color_normalizado": { "type": "string" } },
        "required": ["rol", "color_normalizado"]
      },
      "then": {
        "properties": { "color_normalizado": { "const": "verde-amarillo" } }
      }
    }
  ]
}
