            "const": "rele_auxiliar"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/rele_auxiliar"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "sirena_alarma"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/sirena_alarma"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "instrumento_medicion"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/instrumento_medicion"
      }
