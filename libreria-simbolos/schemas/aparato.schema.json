{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aparato.schema.json",
  "title": "Vatia · Atributos de familia aparato",
  "description": "Fase C / Simbología ampliada. Discriminado por tipo_aparato: cada subtipo define su propio juego de campos cerrado. Los campos con x-obligatorio son advertidos por el Checklist AEA (§C5): no bloquean el guardado, solo advierten.",
  "type": "object",
  "required": [
    "tipo_aparato"
  ],
  "properties": {},
  "allOf": [
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "interruptor_termomagnetico"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/interruptor_termomagnetico"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "contactor"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/contactor"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "fusible"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/fusible"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "motor_trifasico"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/motor_trifasico"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "transformador"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/transformador"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "mccb_caja_moldeada"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/mccb_caja_moldeada"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "guardamotor_termomagnetico"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/guardamotor_termomagnetico"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "rele_termico"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/rele_termico"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "contacto_auxiliar"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/contacto_auxiliar"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "transformador_corriente"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/transformador_corriente"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "banco_capacitores"
