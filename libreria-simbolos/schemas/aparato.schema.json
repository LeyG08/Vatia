{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aparato.schema.json",
  "title": "Vatia · Atributos de familia aparato",
  "description": "Fase C / Simbología ampliada. Discriminado por tipo_aparato: cada subtipo define su propio juego de campos cerrado. Los campos con x-obligatorio son advertidos por el Checklist AEA (§C5): no bloquean el guardado, solo advierten.",
  "type": "object",
  "required": [
    "tipo_aparato"
  ],
  "properties": {},
  "allOf": [
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "interruptor_termomagnetico"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/interruptor_termomagnetico"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "contactor"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/contactor"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "fusible"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/fusible"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "motor_trifasico"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/motor_trifasico"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "transformador"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/transformador"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "mccb_caja_moldeada"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/mccb_caja_moldeada"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "guardamotor_termomagnetico"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/guardamotor_termomagnetico"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "rele_termico"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/rele_termico"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "contacto_auxiliar"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/contacto_auxiliar"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "transformador_corriente"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/transformador_corriente"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "banco_capacitores"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/banco_capacitores"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "portafusible"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/portafusible"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "interruptor_diferencial"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/interruptor_diferencial"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "rele_proteccion_tension"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/rele_proteccion_tension"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "rele_auxiliar"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/rele_auxiliar"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "sirena_alarma"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/sirena_alarma"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "instrumento_medicion"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/instrumento_medicion"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "guardamotor_magnetico"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/guardamotor_magnetico"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "pulsador"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/pulsador"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "selector"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/selector"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "pulsador_emergencia"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/pulsador_emergencia"
      }
    },
    {
      "if": {
        "properties": {
          "tipo_aparato": {
            "const": "lampara_piloto"
          }
        },
        "required": [
          "tipo_aparato"
        ]
      },
      "then": {
        "$ref": "#/$defs/lampara_piloto"
      }
    }
  ],
  "$defs": {
    "base_comun": {
      "description": "Campos comunes a todos los subtipos.",
      "properties": {
        "tipo_aparato": true,
        "marca": {
          "type": "string",
          "x-obligatorio": false,
          "description": "Ej: SICA, Siemens, WEG, Schneider.",
          "title": "Marca"
        },
        "modelo": {
          "type": "string",
          "x-obligatorio": false,
          "description": "Ej: 3TF57, ComPact NSX100.",
          "title": "Modelo"
        }
      }
    },
    "interruptor_termomagnetico": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/base_comun"
        }
      ],
      "properties": {
        "tipo_aparato": {
          "const": "interruptor_termomagnetico",
          "title": "Tipo de aparato"
        },
        "cantidad_polos": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "x-obligatorio": true,
          "description": "Polos que interrumpe, incluido el neutro si lo conmuta. Plano: \"3\", \"4\".",
          "title": "Cantidad de polos"
        },
        "in_a": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": true,
          "description": "Corriente nominal en amperes. Plano: \"50A\".",
          "title": "Corriente nominal (A)"
        },
        "curva_disparo": {
          "enum": [
            "B",
            "C",
            "D",
            "K",
            "Z",
            "otra"
          ],
          "x-obligatorio": false,
          "description": "Plano: \"C\", \"D\".",
          "title": "Curva de disparo"
        },
        "pdcc_kA": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": true,
          "description": "Poder de corte en kiloamperes. El plano lo anota en amperes (\"3000 A\"); se normaliza a kA (3000 A → 3 kA).",
          "title": "Poder de corte (kA)"
        },
        "norma_fabricacion": {
          "type": "string",
          "x-obligatorio": true,
          "description": "Plano: \"IEC 60898-1\".",
          "title": "Norma de fabricación"
        }
      }
    },
    "contactor": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/base_comun"
        }
      ],
      "properties": {
        "tipo_aparato": {
          "const": "contactor",
          "title": "Tipo de aparato"
        },
        "cantidad_polos": {
          "type": "integer",
          "minimum": 1,
          "x-obligatorio": true,
          "description": "Plano KM1: \"Cantidad de polos: 3 polos\".",
          "title": "Cantidad de polos"
        },
        "ue_V": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": true,
          "description": "Tensión de operación en volts. Plano: \"415 [V] CA\".",
          "title": "Tensión de operación (V)"
        },
        "categoria_empleo": {
          "enum": [
            "AC-1",
            "AC-3",
            "AC-4",
            "AC-6b",
            "otra"
          ],
          "x-obligatorio": false,
          "description": "Plano: \"(AC3) 475A\", \"(AC6B)\".",
          "title": "Categoría de empleo"
        },
        "in_a": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": true,
          "description": "Corriente nominal a la categoría declarada. Plano: \"475A\".",
          "title": "Corriente nominal (A)"
        },
        "tension_bobina_v": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": false,
          "description": "Plano: \"220 [V] AC\".",
          "title": "Tensión de bobina (V)"
        }
      }
    },
    "fusible": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/base_comun"
        }
      ],
      "description": "Portafusible y fusible como dos productos distintos, como en las fichas SF-* del plano.",
      "properties": {
        "tipo_aparato": {
          "const": "fusible",
          "title": "Tipo de aparato"
        },
        "portafusible_tension_v": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": false,
          "description": "Tensión asignada del portafusible.",
          "title": "Tensión del portafusible (V)"
        },
        "portafusible_categoria": {
          "type": "string",
          "x-obligatorio": false,
          "description": "Categoría de empleo.",
          "title": "Categoría del portafusible"
        },
        "in_a": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": true,
          "description": "Corriente del fusible instalado.",
          "title": "Corriente nominal (A)"
        },
        "clase_caracteristica": {
          "enum": [
            "gG",
            "gL",
            "aM",
            "F",
            "otra"
          ],
          "x-obligatorio": true,
          "description": "Plano: \"gL/gG\", \"F2A\".",
          "title": "Clase característica"
        },
        "tamano": {
          "type": "string",
          "x-obligatorio": false,
          "description": "Formato del fusible.",
          "title": "Tamaño"
        },
        "pdcc_kA": {
          "type": "number",
          "minimum": 0,
          "x-obligatorio": true,
          "description": "Poder de corte en kiloamperes.",
          "title": "Poder de corte (kA)"
        },
        "norma_fabricacion": {
          "type": "string",
          "x-obligatorio": false,
          "description": "Plano: \"IEC 60269-2\".",
          "title": "Norma de fabricación"
        }
      }
    },
    "motor_trifasico": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/base_comun"
        }
      ],
      "x-alguno-obligatorio": [
        "potencia_kw",
        "potencia_hp"
      ],
      "x-par-automatico": {
        "campos": [
          "potencia_kw",
          "potencia_hp"
        ],
        "factor_hp_a_kw": 0.7457
      },
      "properties": {
        "tipo_aparato": {
          "const": "motor_trifasico",
          "title": "Tipo de aparato"
        },
        "potencia_kw": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": false,
          "title": "Potencia (kW)"
        },
        "potencia_hp": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": false,
          "title": "Potencia (HP)"
        },
        "tension_v": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": true,
          "title": "Tensión (V)"
        },
        "in_a": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": false,
          "title": "Corriente nominal (A)"
        },
        "eficiencia_pct": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "x-obligatorio": false,
          "title": "Eficiencia (%)"
        },
        "factor_potencia": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "x-obligatorio": false,
          "title": "Factor de potencia (cos φ)"
        },
        "rpm": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "x-obligatorio": false,
          "title": "Velocidad (RPM)"
        }
      }
    },
    "transformador": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/base_comun"
        }
      ],
      "properties": {
        "tipo_aparato": {
          "const": "transformador",
          "title": "Tipo de aparato"
        },
        "sn_kva": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": true,
          "title": "Potencia aparente (kVA)"
        },
        "relacion": {
          "type": "string",
          "x-obligatorio": true,
          "title": "Relación de transformación"
        },
        "grupo_conexion": {
          "type": "string",
          "x-obligatorio": false,
          "title": "Grupo de conexión"
        },
        "impedancia_pct": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": false,
          "title": "Impedancia (%)"
        }
      }
    },
    "mccb_caja_moldeada": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/base_comun"
        }
      ],
      "properties": {
        "tipo_aparato": {
          "const": "mccb_caja_moldeada",
          "title": "Tipo de aparato"
        },
        "cantidad_polos": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "x-obligatorio": true,
          "description": "Cantidad de polos (3P, 4P).",
          "title": "Cantidad de polos"
        },
        "tipo_disparo": {
          "enum": [
            "termomagnetico",
            "magnetico",
            "electronico"
          ],
          "x-obligatorio": true,
          "description": "Tecnologia del disparador incorporado. Gobierna que campos de ajuste se habilitan: el termomagnetico y el electronico tienen ajuste termico (Ir), el magnetico solo tiene disparo instantaneo. El simbolo del MCCB es el mismo en los tres casos (interruptor dentro del envolvente moldeado); lo que cambia es la ficha.",
          "title": "Tipo de disparo"
        },
        "ir_a_min": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": true,
          "description": "Ajuste térmico mínimo Ir en amperes.",
          "title": "Ajuste térmico mínimo Ir (A)",
          "x-visible-si": "tipo_disparo:termomagnetico|electronico"
        },
        "ir_a_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": true,
          "description": "Ajuste térmico máximo Ir en amperes.",
          "title": "Ajuste térmico máximo Ir (A)",
          "x-visible-si": "tipo_disparo:termomagnetico|electronico"
        },
        "im_a": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": false,
          "description": "Ajuste magnético Im en amperes.",
          "title": "Ajuste magnético Im (A)"
        },
        "pdcc_kA": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": true,
          "description": "Poder de corte en kA (IEC 60947-2 Icu/Icn).",
          "title": "Poder de corte (kA)"
        },
        "categoria_utilizacion": {
          "enum": [
            "A",
            "B"
          ],
          "x-obligatorio": false,
          "description": "Categoría de utilización IEC 60947-2: A = sin retardo intencional de disparo (protección directa); B = con retardo intencional ajustable, admite selectividad cronométrica con la protección aguas abajo. La mayoría de los MCCB de uso general son categoría A.",
          "title": "Categoría de utilización"
        },
        "icw_kA": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": false,
          "description": "Icw: corriente admisible de corta duración en kA (1 s), solo aplica a categoría B. Es la corriente de cortocircuito que el aparato soporta sin abrir mientras espera el retardo, para dejar actuar primero a la protección aguas abajo.",
          "title": "Icw (kA, 1s)"
        },
        "icm_kA": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": false,
          "description": "Icm: capacidad de cierre en cortocircuito, en kA cresta. Es la corriente de pico que el aparato puede cerrar sin soldarse los contactos, aunque no la despeje; siempre es mayor que Icu.",
          "title": "Icm (kA cresta)"
        },
        "norma_fabricacion": {
          "type": "string",
          "x-obligatorio": true,
          "description": "Norma de fabricación (ej: \"IEC 60947-2\").",
          "title": "Norma de fabricación"
        }
      },
      "description": "Interruptor automatico en caja moldeada (IEC 60947-2). La norma no distingue aparatos por la construccion del envolvente, asi que no hay un simbolo IEC propio del MCCB: se dibuja el interruptor automatico rodeado por el envolvente moldeado, y el tipo de disparo se declara aca, en la ficha, habilitando los campos de ajuste que correspondan."
    },
    "guardamotor_termomagnetico": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/base_comun"
        }
      ],
      "properties": {
        "tipo_aparato": {
          "const": "guardamotor_termomagnetico",
          "title": "Tipo de aparato"
        },
        "cantidad_polos": {
          "type": "integer",
          "minimum": 1,
          "x-obligatorio": true,
          "title": "Cantidad de polos"
        },
        "ue_V": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": true,
          "title": "Tensión de operación (V)"
        },
        "categoria_empleo": {
          "enum": [
            "AC-3",
            "AC-4",
            "otra"
          ],
          "x-obligatorio": false,
          "title": "Categoría de empleo"
        },
        "ir_min_a": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": true,
          "description": "Rango de disparo térmico mínimo.",
          "title": "Disparo térmico mínimo (A)"
        },
        "ir_max_a": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": true,
          "description": "Rango de disparo térmico máximo.",
          "title": "Disparo térmico máximo (A)"
        },
        "ii_a": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": false,
          "description": "Disparo magnético instantáneo Ii.",
          "title": "Disparo magnético instantáneo (A)"
        },
        "icu_kA": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": true,
          "description": "Poder de corte en cortocircuito Icu en kA.",
          "title": "Poder de corte Icu (kA)"
        },
        "ics_kA": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": false,
          "description": "Poder de corte de servicio Ics en kA.",
          "title": "Poder de corte servicio Ics (A)"
        }
      }
    },
    "rele_termico": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/base_comun"
        }
      ],
      "properties": {
        "tipo_aparato": {
          "const": "rele_termico",
          "title": "Tipo de aparato"
        },
        "cantidad_polos": {
          "type": "integer",
          "minimum": 1,
          "x-obligatorio": true,
          "title": "Cantidad de polos"
        },
        "ue_V": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-obligatorio": true,
          "title": "Tensión de operación (V)"
        },
        "categoria_empleo": {
          "enum": [
            "AC-3",
            "AC-4",
